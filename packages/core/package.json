{
  "name": "@volter/tunnel-core",
  "version": "0.1.0",
  "description": "Shared wire-protocol contract for volter-tunnel: control-message types, frame codec, and DTOs. Pure, dependency-free, runtime-agnostic.",
  "type": "module",
  "license": "Apache-2.0",
  "repository": { "type": "git", "url": "git+https://github.com/volter-ai/volter-tunnel.git", "directory": "packages/core" },
  "homepage": "https://github.com/volter-ai/volter-tunnel/tree/main/packages/core#readme",
  "bugs": { "url": "https://github.com/volter-ai/volter-tunnel/issues" },
  "keywords": ["volter-tunnel", "wire-protocol", "tunnel"],
  "engines": { "bun": ">=1.0.0", "node": ">=18" },
  "main": "./dist/index.js",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "bun": "./src/index.ts",
      "types": "./src/index.ts",
      "import": "./dist/index.js"
    }
  },
  "files": ["dist", "src", "README.md"],
  "publishConfig": { "access": "public" },
  "scripts": {
    "build": "tsup src/index.ts --format esm --clean --out-dir dist",
    "prepublishOnly": "bun run build",
    "test": "bun test",
    "typecheck": "tsc --noEmit"
  }
}
