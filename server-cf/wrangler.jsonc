{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "volter-tunnel",
  "main": "src/worker.ts",
  "compatibility_date": "2026-06-16",
  "observability": { "enabled": true },

  "durable_objects": {
    "bindings": [
      { "name": "TUNNEL", "class_name": "TunnelDO" },
      { "name": "ACCOUNTS", "class_name": "AccountDO" },
      { "name": "REGISTRY", "class_name": "RegistryDO" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["TunnelDO"] },
    { "tag": "v2", "new_sqlite_classes": ["AccountDO", "RegistryDO"] }
  ],

  // Durable per-account usage time-series. Requires enabling Analytics Engine on
  // the account first (dash.cloudflare.com → Workers → Analytics Engine); then
  // uncomment this binding and redeploy. The recordAE() calls are no-ops until then.
  // "analytics_engine_datasets": [{ "binding": "USAGE_AE", "dataset": "tunnel_usage" }],

  // Public base domain for tunnel URLs. Tunnel URLs are {tunnelId}.<this>.
  // Use a 1-level wildcard zone so free Universal SSL covers *.<domain>.
  // Override per-env / via `--var` in tests.
  //
  // Metering vars (non-secret) — global ceiling = Σ(account limits) cap, and the
  // built-in internal account's defaults. ROOT_TOKEN is a secret (wrangler secret
  // put ROOT_TOKEN). Credits are charged per request/ws-upgrade by default.
  // Limits are denominated in MONEY. Credits are ops (≈ CF billable events:
  // requests, ws-upgrades, relayed messages) and 1 op = COST_PER_OP_USD
  // (~$1/million, conservative). So these op-limits are a hard dollar cap:
  //   INTERNAL_DAY_LIMIT  10,000,000 ops  = $10/day
  //   INTERNAL_MONTH_LIMIT 100,000,000 ops = $100/month
  // Every account (internal included) is gated the same way. Create/raise with
  // dollars directly: POST /admin/accounts { dayUsd: 10, monthUsd: 100 }.
  // Global = Σ(account limits) ceiling.
  "vars": {
    "TUNNEL_DOMAIN": "voltertest.xyz",
    "INTERNAL_ACCOUNT": "volter-internal",
    "INTERNAL_DAY_LIMIT": "10000000",
    "INTERNAL_MONTH_LIMIT": "100000000",
    "INTERNAL_CONCURRENT": "1000",
    "GLOBAL_DAY_LIMIT": "1000000000",
    "GLOBAL_MONTH_LIMIT": "10000000000",
    "DEFAULT_CONCURRENT": "100",
    "DEFAULT_LEASE_CHUNK": "50",

    // ── Free-tier signup + reservation policy (#2/#3) — confirm vs DECISIONS D6.
    // NOTE: SIGNUP_DAY/MONTH_LIMIT are op-credits (~$1/million). The code default
    // is only 1000 (≈$0.001) — far too small — so set real values here.
    "SIGNUP_DAY_LIMIT": "1000000", //  ≈ $1/day per free account
    "SIGNUP_MONTH_LIMIT": "10000000", //  ≈ $10/month per free account
    "DEFAULT_RESERVED_MAX": "3", //  reserved tunnel ids per free account
    "RESERVATION_IDLE_TTL_DAYS": "60", //  idle days before a reserved id is reclaimable

    // ── Fair-use request burst (#4). Generous defaults: 50 req/s/tunnel sustained,
    // 500 instantaneous (covers heavy page loads / interactive dev), so only real
    // floods are throttled. The daily/monthly credit caps remain the primary limit.
    "BURST_RPS": "50",
    "BURST_SIZE": "500",

    // ── Cost-DoS guard on the unauthenticated public surface (/signup/*, /report).
    "SIGNUP_RPS": "5"

    // Optional (unset = off):
    //   SIGNUP_ALLOWED_USERS — allowlist mode (comma-separated GitHub logins).
    //     UNSET/EMPTY = OPEN signup. Set via `wrangler secret put` so it isn't
    //     committed (logins aren't secret, but keep them out of a public repo).
    //   INSPECT_REPLAY=true  — persisted inspector history + /__volter_replay.
    //   GITHUB_API_BASE      — override the GitHub API (default api.github.com).
  },

  // workers_dev keeps <name>.<acct>.workers.dev available for the control channel
  // (clients connect to <host>/ws?id=...). The wildcard route serves tunnel data.
  "workers_dev": true,
  "routes": [
    { "pattern": "*.voltertest.xyz/*", "zone_name": "voltertest.xyz" }
  ]

  // Secrets (set via `wrangler secret put` in prod, `.dev.vars` locally):
  //   TUNNEL_SECRET, JWT_SECRET, ROOT_TOKEN
}
